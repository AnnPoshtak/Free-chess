{
  "compilerOptions": {
    "target": "ES2020",
    "module": "CommonJS",
    
    "rootDir": "./src",
    "outDir": "./dist",
    
    "strict": true,
    "esModuleInterop": true,
    
    "moduleResolution": "node",
    "resolveJsonModule": true,
    
    "noImplicitAny": true,
    "sourceMap": true,
    
    "skipLibCheck": true,
    "ignoreDeprecations": "6.0"
  },
  "include": ["src"],
  "exclude": ["node_modules"]
}
